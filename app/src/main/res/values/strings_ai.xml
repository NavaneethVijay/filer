    <!-- Settings › AI plugins -->
    <string name="settings_ai_plugins">AI plugins</string>
    <string name="settings_ai_plugins_body">Text in photos, tags, transcripts</string>
    <string name="ai_plugins_title">AI plugins</string>
    <string name="ai_plugins_subtitle">Optional models that read and organise your files. Nothing downloads until you ask.</string>
    <string name="ai_plugins_private_title">Runs only on this phone</string>
    <string name="ai_plugins_private_body">Offline, no account. Works with smart search on or off and never changes your search index.</string>
    <string name="ai_plugins_section">Plugins</string>
    <string name="ai_plugins_free">%s free on this phone</string>

    <string name="plugin_photo_text">Text in photos</string>
    <string name="plugin_photo_text_body">Reads receipts, screenshots and scans when you tap Read text, so you can copy and search their words.</string>
    <string name="plugin_speech">Audio &amp; voice notes</string>
    <string name="plugin_speech_body">Turns a recording into text when you tap Transcribe. Many languages, Indian ones included.</string>
    <string name="plugin_model_photo_text">PP-OCRv6 small</string>
    <string name="plugin_model_speech">Whisper tiny</string>
