    <string name="plugin_remove_title">Remove %s?</string>
    <string name="plugin_remove_body">Its model and what it made (text, transcripts, suggestions) are deleted, here and in smart search. Tags you added stay.</string>

    <string name="photo_text_background">Read photos you already have</string>
    <string name="photo_text_background_body">Only while charging. Otherwise a photo\'s text is read only when you tap Read text.</string>
    <string name="photo_text_progress">%1$d of %2$d photos read</string>
    <string name="plugin_clear">Clear</string>
    <string name="plugin_clear_text">Clear text read so far</string>
    <plurals name="plugin_clear_text_count">
        <item quantity="one">%d photo or scan</item>
        <item quantity="other">%d photos and scans</item>
    </plurals>
    <string name="plugin_clear_text_title">Clear text read from photos?</string>
    <string name="plugin_clear_text_body">The text read from photos and scans is deleted, and search stops finding them by that text. The plugin stays; tap Read text to read a photo again.</string>
    <string name="plugin_clear_text_background">“Read photos you already have” is on, so photos will be read again the next time the phone charges. Turn it off first to keep them cleared.</string>
    <string name="plugin_clear_transcripts">Clear transcripts</string>
    <plurals name="plugin_clear_transcripts_count">
        <item quantity="one">%d recording</item>
        <item quantity="other">%d recordings</item>
    </plurals>
    <string name="plugin_clear_transcripts_title">Clear all transcripts?</string>
    <string name="plugin_clear_transcripts_body">Transcripts are deleted, and search stops finding recordings by what was said. The plugin stays; tap Transcribe to make one again.</string>
    <string name="plugin_clear_tags">Clear suggested tags</string>
    <plurals name="plugin_clear_tags_count">
        <item quantity="one">%d suggested tag</item>
        <item quantity="other">%d suggested tags</item>
    </plurals>
    <string name="plugin_clear_tags_title">Clear suggested tags and names?</string>
    <string name="plugin_clear_tags_body">Suggested tags and file names are deleted. Tags you added yourself stay.</string>
