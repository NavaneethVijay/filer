<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Model download over HTTPS (the only network permission in the app); Developer mode also
         talks to a USB-connected Mac on 127.0.0.1 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service for continuous indexing telemetry (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Where photos were taken (EXIF GPS), for searches like "photos from Goa"; read on-device only -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!-- Fingerprint / screen lock for the Locked folder -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Opening an .apk hands it to the system installer; without this it aborts silently. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Storage insights: whether an installer in Download is for an app that's already installed.
         Checked on the phone only; the list of apps never leaves it. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Full file-manager access (sideloaded app; not distributed through Play) -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".FilerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Filer"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Filer"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands local files to other apps for Open with / Share. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync" />

        <!-- GPU for the AI plugins' language model (LiteRT-LM); optional, CPU is used without them. -->
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

        <receiver
            android:name=".data.worker.IndexNotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.navaneeth.filer.action.INDEX_PAUSE" />
                <action android:name="com.navaneeth.filer.action.INDEX_RESUME" />
                <action android:name="com.navaneeth.filer.action.INDEX_STOP" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
